# Servizio systemd per `segnaposto servi`. Adatta utente e percorsi, poi:
#   sudo cp deploy/segnaposto.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now segnaposto
[Unit]
Description=segnaposto: pseudonimizzazione di testi italiani (solo 127.0.0.1)
After=network.target

[Service]
User=f06academy
Group=f06academy
WorkingDirectory=/home/f06academy/opensource/segnaposto
ExecStart=/home/f06academy/opensource/segnaposto/.venv/bin/segnaposto servi --host 127.0.0.1 --porta 8765 --max-caratteri 3000
Restart=on-failure
RestartSec=5
MemoryMax=1G
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
